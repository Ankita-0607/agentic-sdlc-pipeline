{
  "name": "agentic-sdlc-pipeline",
  "version": "0.1.0",
  "description": "A governed multi-agent software delivery pipeline: issue -> spec -> plan -> code -> tests -> review -> pull request, with policy-as-code guardrails, human approval gates and a tamper-evident audit trail.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "scripts": {
    "asdlc": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:sample": "vitest run --root examples/sample-service",
    "eval": "tsx evals/run.ts",
    "eval:offline": "tsx evals/run.ts --offline"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "commander": "^15.1.0",
    "picomatch": "^4.0.7",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/picomatch": "^4.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
